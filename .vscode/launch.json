{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Desktop: PyWebView",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/service/pywebview_app.py",
      "jinja": true,
      "justMyCode": false
    },
    {
      "name": "Desktop: PyWebView (Dev UI)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/service/pywebview_app.py",
      "env": {
        "AURORA_UI_URL": "http://localhost:5173"
      },
      "jinja": true,
      "justMyCode": true
    },
    {
      "name": "Frontend: npm dev",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/web-ui",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Desktop: Dev (PyWebView + Vite)",
      "configurations": [
        "Desktop: PyWebView (Dev UI)",
        "Frontend: npm dev"
      ]
    },
    {
      "name": "Desktop: Run (PyWebView)",
      "configurations": [
        "Desktop: PyWebView"
      ]
    }
  ]
}
